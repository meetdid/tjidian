<%- include('partials/header') %>

<div class="page-header">
  <div class="container">
    <h1>维修案例详情</h1>
    <p><%= caseItem.categoryName %></p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="article-content">
      <h1><%= caseItem.title %></h1>
      <div class="article-meta">
        <span>📍 <%= caseItem.district %></span>
        <span>📅 <%= caseItem.createdAt.substring(0, 10) %></span>
        <span>🏷️ <%= caseItem.categoryName %></span>
      </div>
      
      <div style="height:350px;background:linear-gradient(135deg,#003d82 0%,#2c3e50 100%);border-radius:12px;margin:30px 0;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.3);font-size:80px;">
        🔧
      </div>
      
      <div class="article-body">
        <h2>设备类型</h2>
        <p><%= caseItem.deviceType %></p>
        
        <h2>故障现象</h2>
        <p><%= caseItem.faultSymptom %></p>
        
        <h2>维修过程</h2>
        <p><%= caseItem.repairProcess %></p>
        
        <h2>解决结果</h2>
        <p><%= caseItem.result %></p>
      </div>
      
      <div style="margin-top:40px;padding:25px;background:#f0f7ff;border-radius:8px;border-left:4px solid #0056b3;">
        <h3 style="color:#0056b3;margin-bottom:10px;">💡 您是否也遇到类似问题？</h3>
        <p style="color:#495057;margin-bottom:15px;">天津机电服务中心专业维修各类工业设备，快速上门，先检测后报价。</p>
        <p>
          <a href="tel:<%= settings.phoneShort %>" class="btn btn-primary">📞 立即咨询</a>
          <a href="/contact" class="btn btn-secondary" style="margin-left:10px;">📝 在线预约</a>
        </p>
      </div>
    </div>
    
    <% if (relatedCases.length > 0) { %>
    <div style="margin-top:50px;">
      <h2 style="text-align:center;margin-bottom:30px;font-size:28px;">相关案例</h2>
      <div class="cases-grid">
        <% relatedCases.slice(0, 3).forEach(function(c) { %>
          <div class="case-card">
            <div class="case-image">
              <span class="case-category"><%= c.categoryName %></span>
              🔧
            </div>
            <div class="case-content">
              <h3><a href="/case/<%= c.slug %>"><%= c.title %></a></h3>
              <div class="case-meta">
                <span>📍 <%= c.district %></span>
                <span>📅 <%= c.createdAt.substring(0, 10) %></span>
              </div>
              <p class="case-desc"><%= c.description %></p>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
