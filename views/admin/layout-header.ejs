<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 天津机电服务中心管理后台</title>
  <link rel="stylesheet" href="/public/css/style.css">
  <style>
    .admin-layout {
      display: flex;
      min-height: 100vh;
    }
    .admin-sidebar {
      width: 220px;
      background: #1a2332;
      color: white;
      flex-shrink: 0;
    }
    .admin-logo {
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .admin-logo h2 {
      color: white;
      font-size: 18px;
      margin-bottom: 5px;
    }
    .admin-logo p {
      font-size: 12px;
      color: rgba(255,255,255,0.5);
    }
    .admin-menu {
      padding: 15px 0;
    }
    .admin-menu a {
      display: block;
      padding: 12px 25px;
      color: rgba(255,255,255,0.7);
      font-size: 14px;
      transition: all 0.3s;
    }
    .admin-menu a:hover,
    .admin-menu a.active {
      background: #0056b3;
      color: white;
    }
    .admin-main {
      flex: 1;
      background: #f8f9fa;
    }
    .admin-header {
      background: white;
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .admin-header h1 {
      font-size: 20px;
      margin: 0;
    }
    .admin-header-right {
      display: flex;
      align-items: center;
      gap: 15px;
    }
    .admin-header-right a {
      color: #495057;
      font-size: 14px;
    }
    .admin-content {
      padding: 25px 30px;
    }
    .admin-card {
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      padding: 25px;
    }
    .admin-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 25px;
    }
    .stat-card {
      background: white;
      border-radius: 8px;
      padding: 25px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .stat-card h3 {
      font-size: 32px;
      color: #0056b3;
      margin-bottom: 8px;
    }
    .stat-card p {
      color: #6c757d;
      font-size: 14px;
    }
    .stat-card.warning h3 {
      color: #e67e22;
    }
    .admin-table {
      width: 100%;
      border-collapse: collapse;
    }
    .admin-table th,
    .admin-table td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid #e9ecef;
      font-size: 14px;
    }
    .admin-table th {
      background: #f8f9fa;
      font-weight: 600;
      color: #495057;
    }
    .admin-table tr:hover {
      background: #f8f9fa;
    }
    .admin-actions {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }
    .admin-actions .btn {
      padding: 8px 18px;
      font-size: 14px;
    }
    .btn-small {
      padding: 5px 12px;
      font-size: 12px;
      display: inline-block;
    }
    .btn-danger {
      background: #dc3545;
      color: white;
    }
    .btn-danger:hover {
      background: #c82333;
      color: white;
    }
    .status-badge {
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      display: inline-block;
    }
    .status-pending {
      background: #fff3cd;
      color: #856404;
    }
    .status-processed {
      background: #d4edda;
      color: #155724;
    }
    .status-completed {
      background: #cce5ff;
      color: #004085;
    }
    .form-group {
      margin-bottom: 18px;
    }
    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
      font-weight: 500;
      color: #495057;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ced4da;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #0056b3;
      box-shadow: 0 0 0 3px rgba(0,86,179,0.1);
    }
    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    .admin-alert {
      padding: 12px 15px;
      border-radius: 6px;
      margin-bottom: 20px;
      font-size: 14px;
    }
    .admin-alert-success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }
    .admin-alert-error {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }
    .page-header-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    .page-header-actions h2 {
      margin: 0;
      font-size: 22px;
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-logo">
        <h2>⚡ 机电服务</h2>
        <p>管理后台</p>
      </div>
      <nav class="admin-menu">
        <a href="/admin" class="<%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">📊 数据概览</a>
        <a href="/admin/services" class="<%= typeof activeMenu !== 'undefined' && activeMenu === 'services' ? 'active' : '' %>">🔧 服务项目</a>
        <a href="/admin/cases" class="<%= typeof activeMenu !== 'undefined' && activeMenu === 'cases' ? 'active' : '' %>">📋 维修案例</a>
        <a href="/admin/articles" class="<%= typeof activeMenu !== 'undefined' && activeMenu === 'articles' ? 'active' : '' %>">📰 文章管理</a>
        <a href="/admin/appointments" class="<%= typeof activeMenu !== 'undefined' && activeMenu === 'appointments' ? 'active' : '' %>">📝 预约管理</a>
        <a href="/admin/settings" class="<%= typeof activeMenu !== 'undefined' && activeMenu === 'settings' ? 'active' : '' %>">⚙️ 网站设置</a>
        <a href="/" target="_blank">🌐 查看网站</a>
        <a href="/admin/logout">🚪 退出登录</a>
      </nav>
    </aside>
    <main class="admin-main">
      <header class="admin-header">
        <h1><%= title %></h1>
        <div class="admin-header-right">
          <span>管理员</span>
          <a href="/admin/logout">退出</a>
        </div>
      </header>
      <div class="admin-content">
