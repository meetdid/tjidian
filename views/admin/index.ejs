<%- include('layout-header', { activeMenu: 'dashboard' }) %>

<div class="admin-stats">
  <div class="stat-card">
    <h3><%= stats.services %></h3>
    <p>服务项目</p>
  </div>
  <div class="stat-card">
    <h3><%= stats.cases %></h3>
    <p>维修案例</p>
  </div>
  <div class="stat-card">
    <h3><%= stats.articles %></h3>
    <p>文章数量</p>
  </div>
  <div class="stat-card warning">
    <h3><%= stats.pendingAppointments %></h3>
    <p>待处理预约</p>
  </div>
</div>

<div class="admin-card">
  <h3 style="margin-bottom:20px;font-size:18px;">欢迎使用管理后台</h3>
  <p style="color:#6c757d;line-height:1.8;margin-bottom:15px;">
    天津机电服务中心网站管理后台，您可以在这里管理网站的所有内容。
  </p>
  <ul style="color:#495057;line-height:2;padding-left:20px;">
    <li>管理维修服务项目</li>
    <li>发布和管理维修案例</li>
    <li>发布和管理行业资讯文章</li>
    <li>查看和处理客户预约</li>
    <li>修改网站设置和联系方式</li>
  </ul>
  <div style="margin-top:25px;padding:20px;background:#f0f7ff;border-radius:8px;">
    <p style="color:#0056b3;font-weight:500;margin-bottom:10px;">💡 快速操作</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <a href="/admin/services/add" class="btn btn-primary btn-small">+ 添加服务项目</a>
      <a href="/admin/cases/add" class="btn btn-primary btn-small">+ 添加维修案例</a>
      <a href="/admin/articles/add" class="btn btn-primary btn-small">+ 发布文章</a>
      <a href="/admin/appointments" class="btn btn-secondary btn-small">查看预约</a>
    </div>
  </div>
</div>

<%- include('layout-footer') %>
