<%- include('layout-header', { activeMenu: 'cases' }) %>

<div class="page-header-actions">
  <h2>维修案例管理</h2>
  <a href="/admin/cases/add" class="btn btn-primary">+ 添加案例</a>
</div>

<div class="admin-card">
  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>标题</th>
        <th>分类</th>
        <th>区域</th>
        <th>日期</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% cases.forEach(function(c) { %>
        <tr>
          <td><%= c.id %></td>
          <td style="max-width:300px;"><%= c.title %></td>
          <td><%= c.categoryName %></td>
          <td><%= c.district %></td>
          <td><%= c.createdAt.substring(0, 10) %></td>
          <td>
            <a href="/admin/cases/edit/<%= c.id %>" class="btn btn-small btn-secondary">编辑</a>
            <form method="post" action="/admin/cases/delete/<%= c.id %>" style="display:inline;" onsubmit="return confirm('确定删除吗？')">
              <button type="submit" class="btn btn-small btn-danger" style="border:none;cursor:pointer;">删除</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('layout-footer') %>
