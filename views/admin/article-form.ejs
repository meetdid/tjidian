<%- include('layout-header', { activeMenu: 'articles' }) %>

<div class="page-header-actions">
  <h2><%= article ? '编辑文章' : '添加文章' %></h2>
  <a href="/admin/articles" class="btn btn-secondary">返回列表</a>
</div>

<% if (error) { %>
  <div class="admin-alert admin-alert-error"><%= error %></div>
<% } %>

<div class="admin-card">
  <form method="post" action="<%= article ? '/admin/articles/edit/' + article.id : '/admin/articles/add' %>">
    <div class="form-grid-2">
      <div class="form-group">
        <label>文章标题 *</label>
        <input type="text" name="title" value="<%= article ? article.title : '' %>" required>
      </div>
      <div class="form-group">
        <label>URL Slug *</label>
        <input type="text" name="slug" value="<%= article ? article.slug : '' %>" required>
      </div>
    </div>
    <div class="form-grid-2">
      <div class="form-group">
        <label>分类</label>
        <select name="category">
          <% [['knowledge','维修知识'],['fault','设备故障'],['tech','行业技术'],['case','维修案例']].forEach(function(cat) { %>
            <option value="<%= cat[0] %>" <%= article && article.category === cat[0] ? 'selected' : '' %>><%= cat[1] %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label>分类名称</label>
        <input type="text" name="categoryName" value="<%= article ? article.categoryName : '' %>">
      </div>
    </div>
    <div class="form-group">
      <label>文章摘要</label>
      <textarea name="summary" rows="3"><%= article ? article.summary : '' %></textarea>
    </div>
    <div class="form-group">
      <label>文章内容（支持HTML）</label>
      <textarea name="content" rows="20"><%= article ? article.content : '' %></textarea>
    </div>
    <div class="form-grid-2">
      <div class="form-group">
        <label>SEO关键词</label>
        <input type="text" name="keywords" value="<%= article ? article.keywords : '' %>">
      </div>
      <div class="form-group">
        <label>作者</label>
        <input type="text" name="author" value="<%= article ? article.author : '管理员' %>">
      </div>
    </div>
    <div class="form-group">
      <label>SEO描述</label>
      <textarea name="description" rows="2"><%= article ? article.description : '' %></textarea>
    </div>
    <div style="margin-top:20px;">
      <button type="submit" class="btn btn-primary">保存</button>
      <a href="/admin/articles" class="btn btn-secondary" style="margin-left:10px;">取消</a>
    </div>
  </form>
</div>

<%- include('layout-footer') %>
