<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/public/css/style.css">
  <style>
    .login-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #1a2332 0%, #003d82 100%);
    }
    .login-box {
      background: white;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      width: 100%;
      max-width: 400px;
    }
    .login-box h1 {
      text-align: center;
      margin-bottom: 10px;
      font-size: 24px;
      color: #1a2332;
    }
    .login-box p.subtitle {
      text-align: center;
      color: #6c757d;
      margin-bottom: 30px;
      font-size: 14px;
    }
    .login-box .form-group {
      margin-bottom: 20px;
    }
    .login-box label {
      display: block;
      margin-bottom: 8px;
      color: #495057;
      font-size: 14px;
      font-weight: 500;
    }
    .login-box input {
      width: 100%;
      padding: 12px 15px;
      border: 1px solid #dee2e6;
      border-radius: 6px;
      font-size: 15px;
      transition: all 0.3s;
    }
    .login-box input:focus {
      outline: none;
      border-color: #0056b3;
      box-shadow: 0 0 0 3px rgba(0,86,179,0.1);
    }
    .login-box .btn {
      width: 100%;
      padding: 14px;
      font-size: 16px;
      margin-top: 10px;
    }
    .login-error {
      padding: 12px;
      background: #f8d7da;
      color: #721c24;
      border-radius: 6px;
      margin-bottom: 20px;
      font-size: 14px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="login-page">
    <div class="login-box">
      <h1>⚡ 天津机电服务中心</h1>
      <p class="subtitle">后台管理系统登录</p>
      <% if (error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>
      <form method="post" action="/admin/login">
        <div class="form-group">
          <label>用户名</label>
          <input type="text" name="username" placeholder="请输入用户名" required>
        </div>
        <div class="form-group">
          <label>密码</label>
          <input type="password" name="password" placeholder="请输入密码" required>
        </div>
        <button type="submit" class="btn btn-primary">登 录</button>
      </form>
      <p style="text-align:center;color:#adb5bd;font-size:12px;margin-top:20px;">
        默认账号：admin / admin123
      </p>
    </div>
  </div>
</body>
</html>
