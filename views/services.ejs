<%- include('partials/header') %>

<div class="page-header">
  <div class="container">
    <h1>维修项目</h1>
    <p>专业维修各类工业设备，为企业提供全方位技术支持</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="services-grid">
      <% services.forEach(function(service) { %>
        <div class="service-card">
          <div class="service-icon">
            <% if(service.icon === 'plc') { %>⚙️
            <% } else if(service.icon === 'inverter') { %>🔌
            <% } else if(service.icon === 'motor') { %>⚡
            <% } else if(service.icon === 'servo') { %>🎯
            <% } else if(service.icon === 'panel') { %>🗄️
            <% } else if(service.icon === 'compressor') { %>💨
            <% } else if(service.icon === 'pump') { %>💧
            <% } else if(service.icon === 'auto') { %>🤖
            <% } else if(service.icon === 'cnc') { %>🔧
            <% } else { %>🔧<% } %>
          </div>
          <h3><%= service.name %></h3>
          <p><%= service.summary %></p>
          <a href="/service/<%= service.slug %>" class="service-link">了解详情 →</a>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="contact-cta">
  <div class="container">
    <div class="cta-content">
      <h2>设备故障？立即联系我们！</h2>
      <p>专业维修工程师快速响应，天津地区上门服务</p>
    </div>
    <div class="cta-phone">
      <div class="cta-phone-icon">📞</div>
      <div class="cta-phone-text">
        <p>维修服务热线</p>
        <a href="tel:<%= settings.phoneShort %>"><%= settings.phone %></a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
